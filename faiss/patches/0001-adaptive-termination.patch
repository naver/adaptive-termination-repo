 #include <vector>
 
 #include <omp.h>
@@ -55,6 +56,33 @@ struct SearchParametersHNSW : SearchParameters {
     bool check_relative_distance = true;
     bool bounded_queue = true;
 
+    /// Adaptive termination. Stop the base-layer beam search as soon as the
+    /// frontier -- the nearest candidate not yet expanded -- is (1+gamma)^2 times
+    /// farther than the k_rule-th best result found so far. Squared because faiss
+    /// L2 distances are squared. 0 disables the rule and leaves faiss untouched.
+    float adaptive_gamma = 0.0f;
+
+    /// Which rank (k_rule) the rule compares against. 0 means the query k.
+    ///
+    /// k_rule may differ from the query k, e.g. a shard that returns k_i results
+    /// can compare against d_K with K > k_i. A larger k_rule raises the threshold,
+    /// so the rule fires later and gives up less recall.
+    ///
+    /// The result heap holds only k entries, so k_rule > k needs its own structure;
+    /// see the auxiliary heap in search_from_candidates_fixVT.
+    int adaptive_k = 0;
+
+    /// Oracle instrumentation (measurement only; leaving these null has no effect
+    /// on faiss behaviour). Each time an id in oracle_targets enters the result
+    /// heap, record the id and the cumulative base-layer distance-computation
+    /// count, in arrival order. The caller decides which ids survived in the final
+    /// result, so points that entered and were later evicted are recorded too.
+    const std::unordered_set<idx_t>* oracle_targets = nullptr;
+    std::vector<int>* oracle_hit_ids = nullptr;    // output
+    std::vector<int>* oracle_hit_ndis = nullptr;   // output
+    int* oracle_base_ndis = nullptr;               // output: total base-layer ndis (to separate the upper-layer share)
+
+
     ~SearchParametersHNSW() {}
 };
 
